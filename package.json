{
  "name": "clod-helper",
  "private": true,
  "version": "0.8.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "bridge:build": "cargo build --release --manifest-path bridge/Cargo.toml && node -e \"require('fs').copyFileSync('bridge/target/release/clod-bridge.exe','src-tauri/resources/clod-bridge.exe')\"",
    "bridge:build:mac": "sh scripts/build-bridge-mac.sh",
    "mock": "vite --port 1420 --strictPort --open /mock.html",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-shell": "^2.5.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.0",
    "lucide-react": "^0.453.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "simple-icons": "^16.27.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
