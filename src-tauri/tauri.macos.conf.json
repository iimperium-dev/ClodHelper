{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clod Helper",
        "width": 700,
        "height": 580,
        "minWidth": 600,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 13 },
        "shadow": true,
        "transparent": false,
        "backgroundColor": "#101312"
      },
      {
        "label": "tray",
        "title": "Clod Helper",
        "url": "index.html?view=tray",
        "width": 332,
        "height": 404,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "resources": ["resources/clod-bridge"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "files": {
        "Library/LaunchAgents/ru.iimperium.clodhelper.autostart.plist": "./macos/ru.iimperium.clodhelper.autostart.plist"
      }
    }
  }
}
