{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clod Helper",
  "version": "0.5.0",
  "identifier": "ru.iimperium.clodhelper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Clod Helper",
        "width": 960,
        "height": 680,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "backgroundColor": "#101312"
      },
      {
        "label": "tray",
        "title": "Clod Helper",
        "url": "index.html?view=tray",
        "width": 332,
        "height": 404,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/clod-bridge.exe",
      "resources/claude-setup.ps1",
      "resources/claude-desktop-setup.ps1",
      "resources/claude-desktop-launch.ps1",
      "resources/claude-proxy-policy.ps1",
      "resources/cursor-setup.ps1"
    ],
    "publisher": "iimperium",
    "copyright": "Copyright (c) 2026 iimperium",
    "category": "DeveloperTool",
    "shortDescription": "Прокси для Claude Code, Claude Desktop и Cursor IDE",
    "longDescription": "Clod Helper — десктопная утилита для установки и настройки Claude Code (CLI), Claude Desktop и Cursor IDE через купленный HTTP-прокси. Нужен в регионах где Anthropic API заблокирован напрямую.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["Russian"]
      }
    }
  }
}
