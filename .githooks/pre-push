#!/bin/sh
# Не даёт отправить на GitHub коммиты с подписью ИИ-помощника
# (иначе GitHub добавляет Claude в участники репозитория).
pattern='^[[:space:]]*co-authored-by:.*(claude|anthropic)|generated with \[?claude code|^[[:space:]]*claude-session:'
zero=0000000000000000000000000000000000000000
bad=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi
  for c in $(git rev-list $range); do
    if git log -1 --format=%B "$c" | grep -qiE "$pattern"; then
      echo "pre-push: в коммите $(git log -1 --format='%h %s' "$c") есть подпись Claude — убери её перед отправкой." >&2
      bad=1
    fi
  done
done
exit $bad
